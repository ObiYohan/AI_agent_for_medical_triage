# Copier ce fichier en .env (ignoré par git) et remplacer la valeur
# Générer une clé : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changez-moi

# Facultatif : jeton Hugging Face en LECTURE (type Read). Le modèle est public ; utile pour un dépôt privé
# (variable MODEL) ou pour des limites de téléchargement plus hautes
HF_TOKEN=

# Facultatif : autre dépôt ou autre révision du modèle (défaut : dans docker-compose.yml)
# MODEL=0biyohan/qwen3-1.7b-medical-triage-fr
# MODEL_REVISION=<identifiant du commit sur le Hub>

